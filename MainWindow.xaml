<Window x:Class="StudentManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Management System"
        Height="600" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FC">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <TextBlock Text="Student Management System"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#243B64"/>

            <TextBlock Text="Manage your student records"
                       FontSize="14"
                       Foreground="Gray"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                Padding="20"
                CornerRadius="12"
                Margin="0,0,0,20">

            <StackPanel>

                <TextBlock Text="Student Name"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="txtStudentName"
                         Height="38"
                         FontSize="15"
                         Padding="8"/>

                <WrapPanel Margin="0,15,0,0">

                    <Button Content="Add Student"
                            x:Name="btnAdd"
                            Width="130"
                            Height="38"
                            Background="#2563EB"
                            Foreground="White"
                            Click="btnAdd_Click"/>

                    <Button Content="Add Range"
                            x:Name="btnAddRange"
                            Width="130"
                            Height="38"
                            Margin="10,0,0,0"
                            Background="#0F9D78"
                            Foreground="White"
                            Click="btnAddRange_Click"/>

                    <Button Content="Remove Student"
                            Width="140"
                            Height="38"
                            Margin="10,0,0,0"
                            Background="#DC5252"
                            Foreground="White"
                            Click="btnRemove_Click"/>

                    <Button Content="Clear All"
                            Width="100"
                            Height="38"
                            Margin="10,0,0,0"
                            Click="btnClear_Click"/>

                </WrapPanel>

            </StackPanel>
        </Border>

        
        <Border Grid.Row="2"
                Background="White"
                Padding="20"
                CornerRadius="12">

            <StackPanel>

                <TextBlock Text="Student List"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,15"/>

                <DataGrid x:Name="studentGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Student Name"
                                            Binding="{Binding}"
                                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>
        </Border>

        <TextBlock x:Name="txtCount"
                   Grid.Row="3"
                   Text="Total Students: 0"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#243B64"
                   Margin="0,15,0,0"/>

    </Grid>
</Window>
